    "estela": "dist/bin.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdleonruiz/estela-cli.git"
  },
  "bugs": {
    "url": "https://github.com/jdleonruiz/estela-cli/issues"
  },
  "homepage": "https://getestela.dev",
  "files": [
    "dist",
    "web",
    "README.md"
  ],
  "dependencies": {
    "@estela/shared": "0.1.0"
  },
  "bundleDependencies": [
    "@estela/shared"
  ],
  "scripts": {
    "prepack": "node ../../scripts/prepack.js",
    "postpack": "node ../../scripts/postpack.js"
  }
}
